# Database Connection (Neon Serverless PostgreSQL or local Docker)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Primary Conversational AI: Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Secondary Conversational AI Fallback: Groq (GPT-OSS tool calling)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tertiary Conversational AI Fallback: OpenAI
OPENAI_API_KEY=

# Enable only behind a proxy that overwrites incoming forwarded headers.
TRUST_PROXY_HEADERS=false
